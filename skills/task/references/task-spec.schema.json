{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi.local/task-spec.schema.json",
  "title": "LingXi TaskSpec",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "userStory": {
      "type": "object",
      "additionalProperties": true,
      "required": ["as_a", "i_want", "so_that", "acceptance_criteria"],
      "properties": {
        "as_a": { "type": "string", "minLength": 1 },
        "i_want": { "type": "string", "minLength": 1 },
        "so_that": { "type": "string", "minLength": 1 },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "functionalRequirement": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "description",
        "implementation_scheme",
        "acceptance_criteria",
        "verification_method",
        "edge_cases",
        "evidence",
        "priority"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "implementation_scheme": { "type": "string", "minLength": 1 },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "verification_method": { "type": "string", "enum": ["unit", "integration", "e2e", "manual", "rubric"] },
        "edge_cases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": { "type": "string", "minLength": 1 },
        "priority": { "type": "string", "enum": ["必须", "应该", "可选"] }
      }
    },
    "projectContext": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "stack",
        "cues",
        "summary",
        "impact",
        "frontend_strength",
        "backend_strength",
        "docs_strength"
      ],
      "properties": {
        "kind": { "type": "string", "enum": ["docs", "frontend", "backend", "mixed", "unknown"] },
        "stack": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary": { "type": "string" },
        "impact": { "type": "string" },
        "frontend_strength": { "type": "integer", "minimum": 0 },
        "backend_strength": { "type": "integer", "minimum": 0 },
        "docs_strength": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "required": [
    "schema_version",
    "title",
    "type",
    "complexity",
    "project_context",
    "background",
    "problem",
    "solution_overview",
    "goals",
    "non_goals",
    "success_criteria",
    "user_stories",
    "functional_requirements",
    "constraints",
    "memory_refs",
    "open_questions",
    "confidence"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "draft-2026-04-07" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "complexity": { "type": "string", "minLength": 1 },
    "project_context": {
      "oneOf": [
        { "$ref": "#/$defs/projectContext" },
        { "type": "null" }
      ]
    },
    "goal": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "task_id": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "background": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 1 },
    "solution_overview": { "type": "string", "minLength": 1 },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "user_stories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/userStory" }
    },
    "functional_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/functionalRequirement" }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "memory_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
