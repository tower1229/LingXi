{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingxi/governance-context.schema.json",
  "title": "GovernanceContext",
  "type": "object",
  "required": ["subject_relation", "conclusion_relation"],
  "additionalProperties": false,
  "properties": {
    "subject_relation": {
      "type": "string",
      "enum": ["same_subject", "different_subject"]
    },
    "conclusion_relation": {
      "type": "string",
      "enum": ["same_conclusion", "non_conflicting", "conflicting", "unknown"]
    },
    "target_note_id": {
      "type": "string"
    },
    "applied_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "idempotency_key": {
      "type": "string"
    }
  }
}
